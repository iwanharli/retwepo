DATABASE_URL=postgres://postgres@localhost:5432/db_retwepo
ORIGIN=http://localhost:5180

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5180/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email admin pertama (dibuat oleh `npm run db:seed`)
ADMIN_EMAIL=harlicuan@gmail.com

# Folder penyimpanan screenshot
UPLOAD_DIR=./uploads

# Body limit untuk adapter-node (produksi)
BODY_SIZE_LIMIT=12M

# Cek nama pemilik e-wallet (opsional, API pihak ketiga / tidak resmi).
# Kosongkan bila tidak dipakai: admin mencocokkan nama secara manual saat transfer.
# Placeholder URL: {provider} (dana/ovo/gopay/shopeepay/linkaja) {number} (08…) {number62} (628…)
EWALLET_CHECK_URL=
EWALLET_CHECK_TOKEN=
EWALLET_CHECK_NAME_PATH=
